## Additional project-specific ignores
## React/Vite build output
/apps/mobile-web/dist/

## Packaged host web root is generated from apps/mobile-web/dist
/apps/windows-host/wwwroot/
/apps/public-site/app/

# Hosting-only database credentials
/apps/public-site/config.php

# Local PHP/MariaDB site development state
/.site-dev/

# Local Codex build and probe output
/.codex-temp/
/.codex-tmp/
/.codex-stats.index

## Keep artifacts out of git
/artifacts/*

# Phone-webcam native MSBuild/NuGet outputs
/apps/windows-host/Features/PhoneWebcam/Native/SetupHelper/SetupHelper/
/apps/windows-host/Features/PhoneWebcam/Native/SetupHelper/x64/
/apps/windows-host/Features/PhoneWebcam/Native/VirtualCameraMediaSource/VirtualC.*/
/apps/windows-host/Features/PhoneWebcam/Native/VirtualCameraMediaSource/obj-package-reference-stale/
/apps/windows-host/Features/PhoneWebcam/Native/VirtualCameraMediaSource/packages/
/apps/windows-host/Features/PhoneWebcam/Native/VirtualCameraMediaSource/x64/
