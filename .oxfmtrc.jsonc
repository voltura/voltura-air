{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/artifacts/**",
    "**/vendor/**",
    "package-lock.json",
    "**/packages.lock.json",
    "**/packages.*.lock.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "apps/mobile-web/public/third-party-notices.txt",
    "apps/windows-host/ThirdPartyNotices/**",
    "apps/windows-host/Features/PhoneWebcam/Native/MICROSOFT-WINDOWS-CAMERA-LICENSE.txt",
    "tests/VolturaAir.Host.Tests/PhoneWebcamTestData/**",
    "apps/mobile-web/src/styles/generated/**",
    "apps/mobile-web/src/ui/tokens.g.ts",
    "apps/windows-host/Styles/Generated/**",
    "apps/public-site/stats.html",
    "apps/public-site/screens/assets/catalog-preview.css",
    "apps/public-site/screens/assets/catalog-preview.js",
    "apps/public-site/app/**",
    "apps/public-site/dev-app/**",
    "**/fixtures/**",
    "**/baselines/**",
    "**/__snapshots__/**",
  ],
}
