{
  "name": "@voltura-air/mobile-web",
  "version": "1.1.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "build": "npm run check && vite build && npm run bundle:check",
    "build:quick": "node ../../scripts/build-mobile-quick.mjs",
    "build:hosted": "cross-env VOLTURA_AIR_HOSTED=1 vite build",
    "build:hosted:dev": "cross-env VOLTURA_AIR_HOSTED=1 VOLTURA_AIR_HOSTED_CHANNEL=development vite build",
    "build:catalog-preview": "vite build --config vite.catalog-preview.config.ts",
    "bundle:check": "node ../../scripts/check-mobile-bundle-size.mjs",
    "check": "npm run typecheck && npm run lint",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "node ../../scripts/check-lint-policy.mjs && oxlint .",
    "lint:architecture": "node --test eslint-rules/*.test.mjs",
    "lint:styles": "stylelint \"src/**/*.css\" --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-web-api": "5.18.6",
    "jsdom": "^30.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
