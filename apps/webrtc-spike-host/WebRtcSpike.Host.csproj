<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <PackageReference Include="Vortice.MediaFoundation" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="ZXing.Net" />
    <Compile Include="..\windows-host\LibDataChannelNative.cs" Link="Reused\LibDataChannelNative.cs" />
    <Compile Include="..\windows-host\NativeUtf8String.cs" Link="Reused\NativeUtf8String.cs" />
    <Compile Include="..\windows-host\NativeInteropPolicy.cs" Link="Reused\NativeInteropPolicy.cs" />
    <Compile Include="..\windows-host\AppLog.Models.cs" Link="Reused\AppLog.Models.cs" />
    <Compile Include="..\windows-host\BuildFeatures.cs" Link="Reused\BuildFeatures.cs" />
    <Compile Include="..\windows-host\JsonOptions.cs" Link="Reused\JsonOptions.cs" />
    <Compile Include="..\windows-host\HostSettingsRegistry.cs" Link="Reused\HostSettingsRegistry.cs" />
    <Compile Include="..\windows-host\NetworkSettings.cs" Link="Reused\NetworkSettings.cs" />
    <Compile Include="..\windows-host\PortSelector.cs" Link="Reused\PortSelector.cs" />
    <Compile Include="..\windows-host\RelayDeviceSessions.cs" Link="Reused\RelayDeviceSessions.cs" />
    <Compile Include="..\windows-host\RelayEndpointDescriptor.cs" Link="Reused\RelayEndpointDescriptor.cs" />
    <Compile Include="..\windows-host\RelayEnvelope.cs" Link="Reused\RelayEnvelope.cs" />
    <Compile Include="..\windows-host\RelayHostConnection.cs" Link="Reused\RelayHostConnection.cs" />
    <Compile Include="..\windows-host\RelayRoutingIdentity.cs" Link="Reused\RelayRoutingIdentity.cs" />
    <Compile Include="..\windows-host\RelaySessionCrypto.cs" Link="Reused\RelaySessionCrypto.cs" />
    <Compile Include="..\windows-host\RelayTurnConfiguration.cs" Link="Reused\RelayTurnConfiguration.cs" />
    <Compile Include="..\windows-host\RelayVirtualWebSocket.cs" Link="Reused\RelayVirtualWebSocket.cs" />
    <Compile Include="..\windows-host\ScreenViewHostIdentity.cs" Link="Reused\ScreenViewHostIdentity.cs" />
    <Compile Include="..\windows-host\TurnTlsBridge.cs" Link="Reused\TurnTlsBridge.cs" />
    <Compile Include="..\windows-host\WebSocketTransport.cs" Link="Reused\WebSocketTransport.cs" />
    <Compile Include="..\windows-host\WebSocketConnectionRegistry.cs" Link="Reused\WebSocketConnectionRegistry.cs" />
    <Compile Include="..\windows-host\Features\PhoneWebcam\H264RtpDepacketizer.cs" Link="Reused\H264RtpDepacketizer.cs" />
    <Compile Include="..\windows-host\Features\PhoneWebcam\MediaFoundationH264Decoder.cs" Link="Reused\MediaFoundationH264Decoder.cs" />
    <Compile Include="..\windows-host\Features\PhoneWebcam\Nv12FrameComposer.cs" Link="Reused\Nv12FrameComposer.cs" />
    <Compile Include="..\windows-host\Features\PhoneWebcam\PhoneWebcamWebRtcPeer.cs" Link="Reused\PhoneWebcamWebRtcPeer.cs" />
    <Content Include="..\windows-host\relay-service.json">
      <Link>relay-service.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\windows-host\Native\win-x64\datachannel.dll">
      <Link>datachannel.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
