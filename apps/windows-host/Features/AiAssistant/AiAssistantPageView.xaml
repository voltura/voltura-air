<UserControl x:Class="VolturaAir.Host.Features.AiAssistant.AiAssistantPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VolturaAir.Host.Ui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NewConversationButton"
                    Grid.Column="1"
                    Content="New conversation"
                    IsEnabled="False"
                    Click="OnNewConversationClicked" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}">
            <Grid>
                <ScrollViewer x:Name="ConversationScroller"
                              Padding="20"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <ui:SpacingStackPanel x:Name="ConversationPanel" Spacing="12" />
                </ScrollViewer>

                <ui:SpacingStackPanel x:Name="StatePanel"
                                      Visibility="Collapsed"
                                      Spacing="10"
                                      MaxWidth="440"
                                      Margin="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                    <TextBlock x:Name="StateTitleText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="StateMessageText"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="RetryButton"
                            Content="Retry"
                            HorizontalAlignment="Center"
                            Click="OnRetryClicked" />
                </ui:SpacingStackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuestionTextBox"
                         MinHeight="58"
                         MaxHeight="116"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="16384"
                         IsEnabled="False"
                         AutomationProperties.Name="Ask the Voltura Air Assistant"
                         TextChanged="OnQuestionTextChanged"
                         PreviewKeyDown="OnQuestionPreviewKeyDown" />
                <Button x:Name="SendButton"
                        Grid.Column="2"
                        Content="Send"
                        MinWidth="76"
                        Height="42"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="OnSendClicked" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   MinHeight="20"
                   Margin="4,8,4,0"
                   Text="Opening AI Assistant…"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
