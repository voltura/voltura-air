<Window x:Class="VolturaAir.Host.Features.Connection.ConnectionExplainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:local="clr-namespace:VolturaAir.Host.Features.Connection"
        xmlns:ui="clr-namespace:VolturaAir.Host.Ui"
        Title="How connections work"
        Width="700"
        SizeToContent="Height"
        MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VolturaAir.Host;component/MainWindow.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource InsetMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{DynamicResource GridSpaceMd}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{DynamicResource GridSpaceMd}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{DynamicResource GridSpaceMd}" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:SpacingStackPanel Spacing="{DynamicResource SpaceXs}">
            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Text="How connections work" />
            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                       Text="Choose a view to see the route. This guide does not change your connection setting."
                       TextWrapping="Wrap" />
        </ui:SpacingStackPanel>

        <Border Grid.Row="2"
                HorizontalAlignment="Left"
                Padding="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}">
            <ui:SpacingStackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceXs}">
                <ToggleButton x:Name="DirectMethodButton"
                              Content="Direct local network"
                              Style="{DynamicResource SegmentButtonStyle}"
                              automation:AutomationProperties.Name="Show Direct local network explanation"
                              Checked="OnMethodChecked"
                              Click="OnMethodClicked" />
                <ToggleButton x:Name="RelayMethodButton"
                              Content="Cloud relay"
                              Style="{DynamicResource SegmentButtonStyle}"
                              automation:AutomationProperties.Name="Show Cloud relay explanation"
                              Checked="OnMethodChecked"
                              Click="OnMethodClicked" />
            </ui:SpacingStackPanel>
        </Border>

        <local:ConnectionRouteDiagram x:Name="RouteDiagramView" Grid.Row="4" />

        <Button Grid.Row="6"
                MinWidth="96"
                HorizontalAlignment="Right"
                Content="Close"
                IsCancel="True"
                Style="{DynamicResource StandardButtonStyle}" />
    </Grid>
</Window>
