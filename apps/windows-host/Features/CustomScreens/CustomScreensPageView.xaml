<UserControl x:Class="VolturaAir.Host.Features.CustomScreens.CustomScreensPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:customScreens="clr-namespace:VolturaAir.Host.Features.CustomScreens"
             xmlns:ui="clr-namespace:VolturaAir.Host.Ui">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CustomScreensPage.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="LibraryRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Build reusable control surfaces and choose which paired devices can use them."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <ui:SpacingStackPanel Grid.Column="1"
                                      Orientation="Horizontal"
                                      VerticalAlignment="Center"
                                      Spacing="12">
                    <CheckBox x:Name="LibraryConfirmDeletesCheckBox"
                              Content="Confirm on delete"
                              Checked="OnConfirmDeletesChanged"
                              Unchecked="OnConfirmDeletesChanged" />
                    <CheckBox x:Name="LibraryConfirmHidesCheckBox"
                              Content="Confirm on hide"
                              Checked="OnConfirmHidesChanged"
                              Unchecked="OnConfirmHidesChanged" />
                    <Button Content="New screen"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="OnNewScreen" />
                </ui:SpacingStackPanel>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ui:SpacingStackPanel x:Name="LibraryList" Spacing="12" />
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Back" Click="OnBack" />
                <TextBox x:Name="ScreenNameInput"
                         Grid.Column="2"
                         MinWidth="240"
                         MaxLength="24"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Custom screen name"
                         TextChanged="OnScreenNameChanged" />
                <ui:SpacingStackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UndoButton" Content="Undo" IsEnabled="False" Click="OnUndo" />
                    <Button x:Name="RedoButton" Content="Redo" IsEnabled="False" Click="OnRedo" />
                    <Button x:Name="EditorPreviewButton"
                            Content="Preview"
                            IsEnabled="False"
                            AutomationProperties.Name="Preview saved custom screen" />
                    <Button Content="Save" Style="{DynamicResource PrimaryButtonStyle}" Click="OnSave" />
                </ui:SpacingStackPanel>
            </Grid>

            <Grid x:Name="EditorWorkspaceGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ComponentPaletteColumn"
                                      Width="210"
                                      MinWidth="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition x:Name="PreviewColumn"
                                      Width="*"
                                      MinWidth="240" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition x:Name="PropertiesPanelColumn"
                                      Width="290"
                                      MinWidth="290" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <ScrollViewer x:Name="ComponentPaletteScroller"
                                  CanContentScroll="False"
                                  Focusable="False"
                                  IsTabStop="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible">
                        <ui:SpacingStackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Components"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />
                                <ui:SpacingStackPanel Grid.Column="1"
                                                      Margin="0,0,1,0"
                                                      Orientation="Horizontal"
                                                      Spacing="4">
                                    <Button x:Name="CollapseAllComponentSectionsButton"
                                            Width="28"
                                            Height="28"
                                            Margin="0"
                                            Padding="0"
                                            Content="&#x2212;"
                                            Style="{DynamicResource CompactIconButtonStyle}"
                                            ToolTip="Collapse all component sections"
                                            AutomationProperties.Name="Collapse all component sections"
                                            Click="OnCollapseAllComponentSections" />
                                    <Button x:Name="ExpandAllComponentSectionsButton"
                                            Width="28"
                                            Height="28"
                                            Margin="0"
                                            Padding="0"
                                            Content="+"
                                            Style="{DynamicResource CompactIconButtonStyle}"
                                            ToolTip="Expand all component sections"
                                            AutomationProperties.Name="Expand all component sections"
                                            Click="OnExpandAllComponentSections" />
                                </ui:SpacingStackPanel>
                            </Grid>
                            <Expander x:Name="AvailableComponentsExpander"
                                      Header="Available components"
                                      IsExpanded="True"
                                      Style="{StaticResource CustomScreenCompactPropertyGroupStyle}">
                              <ui:SpacingStackPanel Spacing="12">
                                <TextBlock Text="Add responsive building blocks, then select them on the canvas."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            <Border x:Name="SectionPaletteItem"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SectionPaletteButton"
                                        Grid.Column="0"
                                        Content="+ Panel"
                                        ContentTemplate="{StaticResource CustomScreenPaletteButtonLabelTemplate}"
                                        Margin="0"
                                        Padding="12,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Click to add a panel"
                                        Click="OnAddSection" />
                                <Button x:Name="SectionPaletteDragHandle"
                                        Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="&#x283F;"
                                        Cursor="SizeAll"
                                        Style="{DynamicResource CompactIconButtonStyle}"
                                        ToolTip="Drag panel onto the layout"
                                        AutomationProperties.Name="Drag Panel onto layout" />
                              </Grid>
                            </Border>
                            <Border x:Name="CollapsibleSectionPaletteItem"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CollapsibleSectionPaletteButton"
                                        Grid.Column="0"
                                        Content="+ Collapsible panel"
                                        ContentTemplate="{StaticResource CustomScreenPaletteButtonLabelTemplate}"
                                        Margin="0"
                                        Padding="12,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Click to add a collapsible panel"
                                        Click="OnAddCollapsibleSection" />
                                <Button x:Name="CollapsibleSectionPaletteDragHandle"
                                        Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="&#x283F;"
                                        Cursor="SizeAll"
                                        Style="{DynamicResource CompactIconButtonStyle}"
                                        ToolTip="Drag collapsible panel onto the layout"
                                        AutomationProperties.Name="Drag Collapsible panel onto layout" />
                              </Grid>
                            </Border>
                            <Border x:Name="ButtonPaletteItem"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ButtonPaletteButton"
                                        Grid.Column="0"
                                        Content="+ Button"
                                        ContentTemplate="{StaticResource CustomScreenPaletteButtonLabelTemplate}"
                                        Margin="0"
                                        Padding="12,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Click to add a button"
                                        Click="OnAddButton" />
                                <Button x:Name="ButtonPaletteDragHandle"
                                        Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="&#x283F;"
                                        Cursor="SizeAll"
                                        Style="{DynamicResource CompactIconButtonStyle}"
                                        ToolTip="Drag button into a panel or row"
                                        AutomationProperties.Name="Drag Button onto layout" />
                              </Grid>
                            </Border>
                            <Border x:Name="VolumePaletteItem"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="VolumePaletteButton"
                                        Grid.Column="0"
                                        Content="+ Volume slider"
                                        ContentTemplate="{StaticResource CustomScreenPaletteButtonLabelTemplate}"
                                        Margin="0"
                                        Padding="12,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Click to add a volume slider"
                                        Click="OnAddVolume" />
                                <Button x:Name="VolumePaletteDragHandle"
                                        Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="&#x283F;"
                                        Cursor="SizeAll"
                                        Style="{DynamicResource CompactIconButtonStyle}"
                                        ToolTip="Drag volume slider onto the layout"
                                        AutomationProperties.Name="Drag Volume slider onto layout" />
                              </Grid>
                            </Border>
                            <Border x:Name="TrackpadPaletteItem"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TrackpadPaletteButton"
                                        Grid.Column="0"
                                        Content="+ Trackpad"
                                        ContentTemplate="{StaticResource CustomScreenPaletteButtonLabelTemplate}"
                                        Margin="0"
                                        Padding="12,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Click to add a trackpad"
                                        Click="OnAddTrackpad" />
                                <Button x:Name="TrackpadPaletteDragHandle"
                                        Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="&#x283F;"
                                        Cursor="SizeAll"
                                        Style="{DynamicResource CompactIconButtonStyle}"
                                        ToolTip="Drag trackpad onto the layout"
                                        AutomationProperties.Name="Drag Trackpad onto layout" />
                              </Grid>
                            </Border>
                            <Border x:Name="CollapsibleTrackpadPaletteItem"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CollapsibleTrackpadPaletteButton"
                                        Grid.Column="0"
                                        Content="+ Collapsible trackpad"
                                        ContentTemplate="{StaticResource CustomScreenPaletteButtonLabelTemplate}"
                                        Margin="0"
                                        Padding="12,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Click to add a collapsible trackpad"
                                        Click="OnAddCollapsibleTrackpad" />
                                <Button x:Name="CollapsibleTrackpadPaletteDragHandle"
                                        Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="&#x283F;"
                                        Cursor="SizeAll"
                                        Style="{DynamicResource CompactIconButtonStyle}"
                                        ToolTip="Drag collapsible trackpad onto the layout"
                                        AutomationProperties.Name="Drag Collapsible trackpad onto layout" />
                              </Grid>
                            </Border>
                              </ui:SpacingStackPanel>
                            </Expander>
                            <Expander x:Name="LayoutOptionsExpander"
                                      Header="Layout"
                                      IsExpanded="False"
                                      Style="{StaticResource CustomScreenCompactPropertyGroupStyle}">
                                <ui:SpacingStackPanel Spacing="10">
                                    <CheckBox x:Name="OrientationLayoutsCheckBox">
                                        <TextBlock Text="Enable orientation layouts"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox x:Name="NavigationHeaderCheckBox">
                                        <TextBlock Text="Show Back and screen title"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                </ui:SpacingStackPanel>
                            </Expander>
                            <Expander x:Name="HiddenControlsRoot"
                                      Header="Hidden controls"
                                      IsExpanded="False"
                                      Visibility="Collapsed"
                                      Style="{StaticResource CustomScreenCompactPropertyGroupStyle}">
                                <ui:SpacingStackPanel Spacing="6">
                                    <TextBlock x:Name="HiddenControlsHint"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <ui:SpacingStackPanel x:Name="HiddenControlsList"
                                                          Spacing="6" />
                                </ui:SpacingStackPanel>
                            </Expander>
                            <Expander x:Name="EditingOptionsExpander"
                                      Header="Editing"
                                      IsExpanded="False"
                                      Style="{StaticResource CustomScreenCompactPropertyGroupStyle}">
                                <ui:SpacingStackPanel Spacing="8">
                                    <CheckBox x:Name="EditorConfirmDeletesCheckBox"
                                              Content="Confirm on delete"
                                              Checked="OnConfirmDeletesChanged"
                                              Unchecked="OnConfirmDeletesChanged" />
                                    <CheckBox x:Name="EditorConfirmHidesCheckBox"
                                              Content="Confirm on hide"
                                              Checked="OnConfirmHidesChanged"
                                              Unchecked="OnConfirmHidesChanged" />
                                </ui:SpacingStackPanel>
                            </Expander>
                        </ui:SpacingStackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter x:Name="ComponentPaletteSplitter"
                              Grid.Column="1"
                              Style="{StaticResource CustomScreenColumnSplitterStyle}"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Resize component palette" />

                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PreviewDeviceCombo"
                                      MinWidth="0"
                                      Style="{DynamicResource ModernComboBoxStyle}"
                                      SelectionChanged="OnPreviewDeviceChanged"
                                      AutomationProperties.Name="Preview device" />
                            <ComboBox x:Name="PreviewOrientationCombo"
                                      Grid.Column="2"
                                      MinWidth="0"
                                      Style="{DynamicResource ModernComboBoxStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="OnPreviewOrientationChanged"
                                      AutomationProperties.Name="Preview orientation">
                                <ComboBoxItem Content="Portrait" Tag="portrait" />
                                <ComboBoxItem Content="Landscape" Tag="landscape" />
                            </ComboBox>
                        </Grid>
                        <Viewbox x:Name="DevicePreviewScaler"
                                 Grid.Row="2"
                                 Stretch="Uniform">
                            <Border x:Name="DeviceFrame"
                                    Width="360"
                                    Height="640"
                                    Background="{DynamicResource WindowBrush}"
                                    BorderBrush="{DynamicResource TextBrush}"
                                    BorderThickness="8"
                                    CornerRadius="28"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="PreviewTitle"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <ScrollViewer x:Name="PreviewWorkspace"
                                                  Grid.Row="2"
                                                  Background="Transparent"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <customScreens:CustomScreenSectionPanel
                                            x:Name="PreviewSections" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Grid>
                </Border>

                <GridSplitter x:Name="PropertiesPanelSplitter"
                              Grid.Column="3"
                              Style="{StaticResource CustomScreenColumnSplitterStyle}"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Resize properties panel" />

                <Border Grid.Column="4"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Visible">
                        <ui:SpacingStackPanel x:Name="PropertiesPanel" Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Properties"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />
                                <ui:SpacingStackPanel Grid.Column="1"
                                                      Margin="0,0,1,0"
                                                      Orientation="Horizontal"
                                                      Spacing="4">
                                    <Button x:Name="CollapseAllPropertiesButton"
                                            Width="28"
                                            Height="28"
                                            Margin="0"
                                            Padding="0"
                                            Content="&#x2212;"
                                            Style="{DynamicResource CompactIconButtonStyle}"
                                            ToolTip="Collapse all properties"
                                            AutomationProperties.Name="Collapse all properties"
                                            Click="OnCollapseAllProperties" />
                                    <Button x:Name="ExpandAllPropertiesButton"
                                            Width="28"
                                            Height="28"
                                            Margin="0"
                                            Padding="0"
                                            Content="+"
                                            Style="{DynamicResource CompactIconButtonStyle}"
                                            ToolTip="Expand all properties"
                                            AutomationProperties.Name="Expand all properties"
                                            Click="OnExpandAllProperties" />
                                </ui:SpacingStackPanel>
                            </Grid>
                            <TextBlock x:Name="PropertiesHint"
                                       Text="Select a panel or button on the preview."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </ui:SpacingStackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
