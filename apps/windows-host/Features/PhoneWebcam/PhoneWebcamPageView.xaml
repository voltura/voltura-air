<UserControl x:Class="VolturaAir.Host.Features.PhoneWebcam.PhoneWebcamPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VolturaAir.Host.Ui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="{DynamicResource InsetLg}">
                <ui:SpacingStackPanel Spacing="{DynamicResource SpaceMd}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource GridSpaceSm}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Windows camera"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="InstallationStatusText"
                                   Grid.Column="2"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                    <TextBlock x:Name="SessionStatusText"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{DynamicResource GridSpaceMd}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AllowPairedDevicesCheckBox"
                                  Content="Allow paired devices" />
                        <Button x:Name="RetryPreviewButton"
                                Grid.Column="2"
                                Content="Retry preview"
                                Visibility="Collapsed" />
                    </Grid>
                </ui:SpacingStackPanel>
            </Border>

            <Border Grid.Row="1"
                    Height="{DynamicResource SpaceLg}" />

            <Border x:Name="PreviewSurface"
                    Grid.Row="2"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Height="360"
                    VerticalAlignment="Top">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Visibility="Collapsed"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <ui:SpacingStackPanel x:Name="PreviewEmptyState"
                                          Spacing="{DynamicResource SpaceSm}"
                                          MaxWidth="560"
                                          Margin="{DynamicResource InsetLg}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewEmptyTitle"
                                   Text="Connect your phone"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="PreviewEmptyMessage"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </ui:SpacingStackPanel>
                </Grid>
            </Border>

    </Grid>
</UserControl>
