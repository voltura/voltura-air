<UserControl x:Class="VolturaAir.Host.Features.Preferences.PreferencesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:ui="clr-namespace:VolturaAir.Host.Ui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{DynamicResource GridSpaceSm}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="SearchAnchor">
            <Border x:Name="SearchChrome"
                    MinHeight="44"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    SizeChanged="OnSearchChromeSizeChanged">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="20"
                          Height="20"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Ellipse Width="13"
                                 Height="13"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Stroke="{DynamicResource TextBrush}"
                                 StrokeThickness="1.7" />
                        <Path Data="M 11,11 L 18,18"
                              Stroke="{DynamicResource TextBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                    <ui:WatermarkedTextBox x:Name="SearchBox"
                                           Grid.Column="1"
                                           MinHeight="42"
                                           Padding="10,6,4,6"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Placeholder="Find a setting"
                                           PlaceholderForeground="{DynamicResource MutedTextBrush}"
                                           automation:AutomationProperties.Name="Find a setting"
                                           TextChanged="OnSearchTextChanged"
                                           GotKeyboardFocus="OnSearchGotKeyboardFocus"
                                           PreviewKeyDown="OnSearchPreviewKeyDown"
                                           PreviewMouseLeftButtonDown="OnSearchPreviewMouseLeftButtonDown" />
                    <Grid Grid.Column="2" Margin="2,0,4,0">
                        <Button x:Name="ClearSearchButton"
                                Width="36"
                                Height="36"
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Style="{DynamicResource CompactIconButtonStyle}"
                                ToolTip="Clear search"
                                automation:AutomationProperties.Name="Clear search"
                                Visibility="Collapsed"
                                Click="OnClearSearchClicked">
                            <Grid Width="16" Height="16">
                                <Path Data="M 3,3 L 13,13"
                                      Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M 13,3 L 3,13"
                                      Stroke="{DynamicResource TextBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Popup x:Name="SearchResultsPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=SearchChrome}"
                   VerticalOffset="4"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   Opened="OnSearchResultsOpened">
                <Border x:Name="SearchResultsBorder"
                        MaxHeight="440"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6">
                    <Grid>
                        <ListBox x:Name="SearchResultsList"
                                 Style="{DynamicResource ModernListBoxStyle}"
                                 ItemContainerStyle="{DynamicResource ModernListBoxItemStyle}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="OnResultsPreviewKeyDown"
                                 PreviewMouseLeftButtonUp="OnResultsPreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="46"
                                            Padding="10,7"
                                            Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding Breadcrumb}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoSearchResultsText"
                                   MinHeight="46"
                                   Padding="10,7"
                                   VerticalAlignment="Center"
                                   Text="No settings found"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <ScrollViewer x:Name="PreferencesScroller"
                      Grid.Row="2"
                      CanContentScroll="False"
                      Focusable="False"
                      IsTabStop="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Visible">
            <ui:SpacingStackPanel Spacing="{DynamicResource SpaceSm}">
            <Expander x:Name="ApplicationSection"
                      Header="Application"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="ApplicationContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="AppearanceSection"
                      Header="Appearance"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="AppearanceContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="TrackpadSection"
                      Header="Trackpad defaults"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="TrackpadContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="RemoteSection"
                      Header="Remote defaults"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="RemoteContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="PresentationSection"
                      Header="Presentation"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="PresentationContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="AwakeSection"
                      Header="Keep awake"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="AwakeContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="PermissionsSection"
                      Header="Global permissions"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="PermissionsContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="ScreenViewSection"
                      Header="Screen viewing"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="ScreenViewContent"
                                      Spacing="{DynamicResource SpaceSm}" />
            </Expander>
            <Expander x:Name="TextDestinationSection"
                      Header="Text destination"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="TextDestinationContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="AppLaunchSection"
                      Header="Application launch buttons"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="AppLaunchContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="CustomPointerSection"
                      Header="Custom pointer"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="CustomPointerContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            <Expander x:Name="DeveloperSection"
                      Header="Developer tools"
                      IsExpanded="False"
                      Style="{DynamicResource PreferencesAccordionStyle}">
                <ui:SpacingStackPanel x:Name="DeveloperContent"
                                      Spacing="{DynamicResource SpaceMd}" />
            </Expander>
            </ui:SpacingStackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
