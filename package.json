{
  "name": "voltura-air",
  "private": true,
  "version": "0.9.3",
  "license": "MIT",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": "11.18.0"
  },
  "workspaces": [
    "apps/mobile-web",
    "services/relay"
  ],
  "scripts": {
    "actions:restore": "node scripts/restore-github-actions.mjs",
    "ai:init": "npm run ai:update && npm run ai:schedule:create && npm run ai:shortcut:create",
    "ai:schedule:create": "node scripts/ai-schedule.mjs",
    "ai:schedule:remove": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/remove-chatgpt-codex-schedule.ps1",
    "ai:shortcut:create": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/create-chatgpt-codex-shortcut.ps1",
    "ai:shortcut:remove": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/remove-chatgpt-codex-shortcut.ps1",
    "ai:update": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/update-chatgpt-codex.ps1",
    "branch:sync": "node scripts/sync-branch.mjs",
    "build": "npm run ui:tokens:check && npm run build --workspace apps/mobile-web && dotnet build VolturaAir.slnx -p:RestoreLockedMode=true",
    "branding:generate": "npm run icons:generate && npm run screenshots:site",
    "cache:purge": "node scripts/purge-windows-icon-cache.mjs",
    "clean:git": "git gc --prune=now",
    "clean:temp": "git clean -fdX -e !/.vs/ -e !/.vs/** -e !/.vscode/settings.json",
    "clean:temp:preview": "git clean -ndX -e !/.vs/ -e !/.vs/** -e !/.vscode/settings.json",
    "code:statistics": "node scripts/code-statistics.mjs",
    "deps:check": "node scripts/check-dependencies.mjs",
    "deps:update": "npm update --workspaces --include-workspace-root",
    "docs:check": "node scripts/check-documentation-map.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "host:ownership:check": "node scripts/check-host-partial-ownership.mjs",
    "help": "node scripts/command-help.mjs",
    "lint": "npm run lint --workspace apps/mobile-web",
    "maintenance:full": "npm run cache:purge && npm run clean:temp && npm run clean:git && npm run deps:update",
    "dev": "node scripts/dev.mjs",
    "dev:quick": "node scripts/dev.mjs --quick",
    "dev:bare-source": "npm run package:source:bare",
    "dev:host": "node scripts/dev-host.mjs",
    "dev:source": "npm run package:source",
    "dev:ui": "node scripts/dev-ui-with-devices.mjs",
    "dev:web": "npm run dev --workspace apps/mobile-web",
    "package:source": "pwsh -NoProfile -File scripts/zip-clean-repo.ps1",
    "package:source:bare": "pwsh -NoProfile -File scripts/zip-clean-repo.ps1 -Bare",
    "package:win": "pwsh -NoProfile -File scripts/package-win.ps1",
    "package:win:small": "pwsh -NoProfile -File scripts/package-win.ps1 -FrameworkDependentOnly",
    "package:win:test": "pwsh -NoProfile -File scripts/package-win.ps1 -NoInstallerCompression",
    "powershell:check": "pwsh -NoProfile -File scripts/check-powershell.ps1",
    "release": "pwsh -NoProfile -File scripts/prepare-release.ps1",
    "release:bump": "node scripts/bump-release.mjs",
    "release:draft": "node scripts/release-publish.mjs",
    "release:full": "node scripts/release-publish.mjs --publish-latest",
    "release:sync-release-notes": "node scripts/sync-release-notes.mjs",
    "relay:check": "npm run check --workspace @voltura-air/relay",
    "relay:deploy": "npm run deploy --workspace @voltura-air/relay",
    "relay:health": "node scripts/check-relay-health.mjs",
    "relay:setup": "pwsh -NoProfile -File scripts/relay-setup.ps1",
    "relay:usage": "pwsh -NoProfile -File scripts/relay-usage.ps1",
    "screenshots:site": "node scripts/capture-site-screenshots.mjs",
    "screens:generate": "node scripts/generate-custom-screens.mjs",
    "screens:check": "node scripts/generate-custom-screens.mjs --check && node scripts/check-custom-screen-layouts.mjs",
    "screens:official": "node scripts/generate-custom-screens.mjs --official",
    "screens:layout-check": "node scripts/check-custom-screen-layouts.mjs",
    "screen-view:layout-check": "node scripts/check-screen-view-layout.mjs",
    "site:dev:init": "pwsh -NoProfile -File scripts/site-dev-init.ps1",
    "site:dev:admin": "pwsh -NoProfile -File scripts/site-dev-admin.ps1",
    "site:check": "pwsh -NoProfile -File scripts/check-site.ps1",
    "site:dev": "pwsh -NoProfile -File scripts/site-dev.ps1",
    "site:preview:build": "npm run build:catalog-preview --workspace apps/mobile-web",
    "site:hosted:build": "npm run build:hosted --workspace apps/mobile-web",
    "third-party:check": "node scripts/generate-third-party-notices.mjs --check",
    "third-party:generate": "node scripts/generate-third-party-notices.mjs",
    "publish:site": "node scripts/publish-site.mjs",
    "publish:site:prepared": "node scripts/publish-site.mjs --prepared",
    "publish:site:list": "node scripts/publish-site.mjs --list",
    "publish:site:password": "pwsh -NoProfile -File scripts/site-publish-password.ps1",
    "publish:site:password:clear": "pwsh -NoProfile -File scripts/site-publish-password.ps1 -Clear",
    "size:report": "node scripts/report-source-sizes.mjs",
    "size:check": "node scripts/report-source-sizes.mjs --check",
    "tools:check": "node scripts/check-toolchain.mjs",
    "test": "npm run docs:check && npm run tools:check && npm run third-party:check && npm run ui:tokens:check && npm run size:check && npm run host:ownership:check && npm run powershell:check && npm run site:check && npm run relay:check && npm run test:web && npm run test:scripts && dotnet test VolturaAir.slnx -p:RestoreLockedMode=true",
    "test:web": "npm run test --workspace apps/mobile-web -- --run && npm run screen-view:layout-check",
    "test:host": "dotnet test VolturaAir.slnx",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:site-import-integration": "cross-env VOLTURA_AIR_SCREENS_CONFIG=.site-dev/config.php php -c .site-dev/php.ini -d extension=zip tests/site-official-import-integration.php",
    "test:ui": "node scripts/dev-ui-with-devices.mjs --smoke-test",
    "ui:tokens:check": "node scripts/generate-ui-tokens.mjs --check",
    "ui:tokens:generate": "node scripts/generate-ui-tokens.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true,
    "cpu-features": false
  }
}
