RELAY_HOSTNAME=relay-example.duckdns.org
TURN_HOSTNAME=turn-example.duckdns.org
TURN_PUBLIC_IP=replace-with-public-wan-ipv4
DUCKDNS_SUBDOMAINS=relay-example,turn-example
DUCKDNS_TOKEN=replace-with-duckdns-token
TURN_SHARED_SECRET=replace-with-at-least-32-random-characters
CERTIFICATE_PATH=/etc/letsencrypt/live/relay-example.duckdns.org/fullchain.pem
CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/relay-example.duckdns.org/privkey.pem
