worker_processes auto;
events { worker_connections 1024; }

stream {
  map $ssl_preread_server_name $selected_upstream {
    ${RELAY_HOSTNAME} relay_https;
    ${TURN_HOSTNAME} turn_tls;
    default reject;
  }
  upstream relay_https { server 127.0.0.1:8443; }
  upstream turn_tls { server coturn:5349; }
  upstream reject { server 127.0.0.1:9; }
  server {
    listen 443;
    proxy_pass $selected_upstream;
    ssl_preread on;
  }
}

http {
  server {
    listen 8443 ssl;
    server_name ${RELAY_HOSTNAME};
    ssl_certificate /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
      proxy_pass http://relay:8787;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_read_timeout 75s;
    }
  }
}
