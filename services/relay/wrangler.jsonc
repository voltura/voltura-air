{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voltura-air-relay",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_ROOMS", "class_name": "RelayRoomObject" },
      { "name": "SECURE_DIRECT_ROOMS", "class_name": "SecureDirectRoomObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["SecureDirectRoomObject"] }
  ],
  "vars": {
    "PUBLIC_SERVICE_ID": "voltura-cloud-v1",
    "ALLOWED_DEVICE_ORIGIN": "https://voltura.se",
    "USAGE_WARNING_BYTES": "750000000000",
    "USAGE_CUTOFF_BYTES": "850000000000"
  }
}
