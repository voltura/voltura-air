{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voltura-air-relay-development",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-08-03",
  "workers_dev": false,
  "logpush": false,
  "observability": {
    "enabled": false,
    "issues": { "enabled": false },
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false,
    },
    "traces": { "enabled": false, "persist": false },
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_ROOMS", "class_name": "RelayRoomObject" },
      { "name": "SECURE_DIRECT_ROOMS", "class_name": "SecureDirectRoomObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["SecureDirectRoomObject"] },
  ],
  "vars": {
    "PUBLIC_SERVICE_ID": "development-only",
    "ALLOWED_DEVICE_ORIGIN": "https://example.invalid",
    "USAGE_WARNING_BYTES": "1000000000000",
    "USAGE_CUTOFF_BYTES": "2000000000000",
  },
}
